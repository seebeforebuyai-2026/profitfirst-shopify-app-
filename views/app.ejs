<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>ProfitFirst Analytics</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    /* Full screen centered layout */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #0a1628;       /* dark navy background */
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: 'Inter', sans-serif;
      color: #fff;
    }

    /* Logo */
    .logo { width: 180px; margin-bottom: 40px; }

    /* Spinner */
    .spinner {
      width: 48px; height: 48px;
      border: 4px solid rgba(255,255,255,0.15);
      border-top-color: #26b35e;   /* green accent */
      border-radius: 50%;
      animation: spin 0.9s linear infinite;
      margin-bottom: 28px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Text */
    .main-text { font-size: 1.25rem; font-weight: 600; margin-bottom: 10px; }
    .sub-text   { font-size: 0.9rem; color: rgba(255,255,255,0.5); }

    /* Error state (hidden by default) */
    .error-box {
      display: none;
      margin-top: 30px;
      background: rgba(220, 53, 69, 0.15);
      border: 1px solid rgba(220, 53, 69, 0.4);
      padding: 14px 24px;
      border-radius: 8px;
      color: #ff6b6b;
      font-size: 0.9rem;
      text-align: center;
      max-width: 360px;
    }
  </style>
</head>
<body>

  <!-- Logo -->
  <img
    class="logo"
    src="https://res.cloudinary.com/dqdvr35aj/image/upload/v1748330108/Logo1_zbbbz4.png"
    alt="ProfitFirst Analytics"
  />

  <!-- Spinner -->
  <div class="spinner"></div>

  <!-- Text -->
  <div class="main-text">Connecting your store...</div>
  <div class="sub-text">Please wait while we set up your dashboard</div>

  <!-- Error box (shown only on failure) -->
  <div class="error-box" id="error-box">
    Something went wrong. Please close this and try again from Shopify.
  </div>

  <script>
    // EJS se shop value inject hogi
    const shop = '<%= shop %>';

    // Page load hote hi SSO redirect call karo
    fetch('/sso-redirect?shop=' + encodeURIComponent(shop))
      .then(res => {
        if (!res.ok) throw new Error('Server error: ' + res.status);
        return res.json();
      })
      .then(data => {
        if (data.redirectUrl) {
          // Redirect to profitfirstanalytics.co.in with SSO token
          window.location.href = data.redirectUrl;
        } else {
          throw new Error('No redirect URL received');
        }
      })
      .catch(err => {
        console.error('SSO Error:', err);
        document.getElementById('error-box').style.display = 'block';
      });
  </script>

</body>
</html>
